{
  "name": "@arthur-lobo/timefy",
  "version": "1.1.0",
  "description": "A simple and intuitive library for time manipulation, timeouts, and intervals",
  "keywords": [
    "time",
    "timefy",
    "timeout",
    "interval",
    "time manipulation",
    "milliseconds",
    "seconds",
    "minutes",
    "hours"
  ],
  "license": "MIT",
  "author": "Arthur Lobo",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest --run",
    "build": "tsup",
    "prepack": "tsup",
    "lint": "biome check",
    "lint:fix": "biome check --write"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "4.1.5",
    "lefthook": "^2.1.6",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
